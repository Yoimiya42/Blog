// Wrangler resolves D1 migration targets from top-level bindings only.
// This file exposes the preview database to `wrangler d1 migrations`.
// Keep the name and id identical to `previews.d1_databases` in wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "blog-preview",
      "database_id": "ca1469cb-37d3-4e11-aebc-4bd358decf27",
      "migrations_dir": "migrations",
    },
  ],
}
